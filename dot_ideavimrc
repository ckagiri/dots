package com.example.validationmicroservice.common;

import java.util.Objects;
import java.util.Optional;
import java.util.function.Consumer;
import java.util.function.Function;

/**
 * Simple Result type representing either a success (T) or failure (E).
 */
public final class Result<T, E> {

    private final T success;
    private final E error;

    private Result(T success, E error) {
        this.success = success;
        this.error = error;
    }

    public static <T, E> Result<T, E> success(T value) {
        Objects.requireNonNull(value, "success value must not be null");
        return new Result<>(value, null);
    }

    public static <T, E> Result<T, E> failure(E error) {
        Objects.requireNonNull(error, "error must not be null");
        return new Result<>(null, error);
    }

    public boolean isSuccess() {
        return success != null;
    }

    public boolean isFailure() {
        return error != null;
    }

    public T getSuccess() {
        return success;
    }

    public E getError() {
        return error;
    }

    public Optional<T> success() {
        return Optional.ofNullable(success);
    }

    public Optional<E> error() {
        return Optional.ofNullable(error);
    }

    public T orElse(T defaultValue) {
        return isSuccess() ? success : defaultValue;
    }

    public <U> Result<U, E> map(Function<T, U> mapper) {
        if (isSuccess()) {
            return Result.success(mapper.apply(success));
        }
        return Result.failure(error);
    }

    public <U> Result<U, E> flatMap(Function<T, Result<U, E>> mapper) {
        if (isSuccess()) {
            return Objects.requireNonNull(mapper.apply(success));
        }
        return Result.failure(error);
    }

    public <R> R unwrapOrElse(Function<E, R> errorMapper) {
        if (isSuccess()) {
            @SuppressWarnings("unchecked")
            R value = (R) success;
            return value;
        }
        return errorMapper.apply(error);
    }

    public Result<T, E> onSuccess(Consumer<T> action) {
        if (isSuccess()) {
            action.accept(success);
        }
        return this;
    }

    public Result<T, E> onFailure(Consumer<E> action) {
        if (isFailure()) {
            action.accept(error);
        }
        return this;
    }
}

